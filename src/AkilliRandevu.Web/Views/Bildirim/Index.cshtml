@using AkilliRandevu.Entities.Enums
@inject AkilliRandevu.Business.Abstract.ISaat Saat
@model List<AkilliRandevu.Entities.Concrete.Bildirim>
@{
    ViewData["Title"] = "Bildirimler";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Bildirimler</h1>
    @if (Model.Any(b => !b.OkunduMu))
    {
        <form asp-action="OkunduYap" method="post">
            <button type="submit" class="btn btn-sm btn-outline-secondary">Tümünü okundu yap</button>
        </form>
    }
</div>

@if (Model.Count == 0)
{
    <p class="text-muted">Bildiriminiz yok.</p>
}
else
{
    <div class="list-group">
        @foreach (var b in Model)
        {
            var eposta = b.EpostaGonderimleri.OrderByDescending(e => e.Id).FirstOrDefault();
            <div class="list-group-item @(b.OkunduMu ? "" : "list-group-item-primary")">
                <div class="d-flex justify-content-between flex-wrap gap-2">
                    <strong>@b.Baslik</strong>
                    <small class="text-muted">@Saat.YereleCevir(b.OlusturmaTarihi).ToString("dd.MM.yyyy HH:mm")</small>
                </div>
                <div>@b.Mesaj</div>
                <div class="d-flex justify-content-between align-items-center mt-1">
                    <small class="text-muted">
                        E-posta:
                        @(eposta?.Durum switch
                        {
                            GonderimDurumu.Gonderildi => "gönderildi",
                            GonderimDurumu.Bekliyor => "gönderilmeyi bekliyor",
                            GonderimDurumu.Basarisiz => "gönderilemedi",
                            GonderimDurumu.Atlandi => "e-posta servisi kapalı",
                            _ => "—"
                        })
                    </small>
                    @if (!b.OkunduMu)
                    {
                        <form asp-action="OkunduYap" asp-route-id="@b.Id" method="post">
                            <button type="submit" class="btn btn-sm btn-link p-0">Okundu</button>
                        </form>
                    }
                </div>
            </div>
        }
    </div>
}
