@model ErrorViewModel
@{
    ViewData["Title"] = "Hata";
}

<div class="text-center py-5">
    <h1 class="h3">Beklenmeyen bir hata oluştu</h1>
    <p class="text-muted">İsteğiniz işlenirken bir sorun çıktı. Lütfen biraz sonra tekrar deneyin.</p>
    @if (Model?.ShowRequestId == true)
    {
        <p class="small text-muted">Hata kodu: <code>@Model.RequestId</code> (destek için bu kodu iletebilirsiniz)</p>
    }
    <a class="btn btn-outline-primary" asp-controller="Home" asp-action="Index">Ana sayfaya dön</a>
</div>
