@using AkilliRandevu.Entities.Enums
@inject AkilliRandevu.Business.Abstract.ISaat Saat
@model List<AkilliRandevu.Entities.Concrete.EpostaGonderimi>
@{
    ViewData["Title"] = "E-posta gönderimleri";
    var yapilandirildi = (bool)ViewData["Yapilandirildi"]!;
    var yonlendirme = ViewData["Yonlendirme"] as string;
}

<h1 class="h3 mb-3">E-posta gönderimleri</h1>

<div class="card mb-3">
    <div class="card-body d-flex flex-wrap justify-content-between align-items-center gap-2">
        <div>
            <div>
                E-posta servisi:
                @if (yapilandirildi)
                {
                    <span class="badge text-bg-success">Yapılandırıldı</span>
                }
                else
                {
                    <span class="badge text-bg-secondary">Kapalı</span>
                    <small class="text-muted">(Eposta__ApiAnahtari ve Eposta__GondericiAdres ortam değişkenleri ayarlanmamış)</small>
                }
            </div>
            @if (!string.IsNullOrWhiteSpace(yonlendirme))
            {
                <small class="text-muted">Demo yönlendirmesi açık: tüm e-postalar <code>@yonlendirme</code> adresine gider.</small>
            }
        </div>
        <form asp-action="TestEpostasi" method="post">
            <button type="submit" class="btn btn-outline-primary">Test e-postası gönder</button>
        </form>
    </div>
</div>

@if (Model.Count == 0)
{
    <p class="text-muted">Henüz e-posta kaydı yok.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-sm table-striped align-middle">
            <thead>
                <tr>
                    <th>Oluşturma</th>
                    <th>Alıcı</th>
                    <th>Konu</th>
                    <th>Durum</th>
                    <th>Deneme</th>
                    <th>Gönderim</th>
                    <th>Son hata</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var e in Model)
                {
                    var (metin, renk) = e.Durum switch
                    {
                        GonderimDurumu.Gonderildi => ("Gönderildi", "success"),
                        GonderimDurumu.Bekliyor => ("Bekliyor", "primary"),
                        GonderimDurumu.Basarisiz => ("Başarısız", "danger"),
                        _ => ("Atlandı", "secondary")
                    };
                    <tr>
                        <td>@Saat.YereleCevir(e.OlusturmaTarihi).ToString("dd.MM HH:mm")</td>
                        <td>@e.Alici</td>
                        <td>@e.Bildirim.Baslik</td>
                        <td><span class="badge text-bg-@renk">@metin</span></td>
                        <td>@e.DenemeSayisi</td>
                        <td>@(e.GonderimTarihi is { } g ? Saat.YereleCevir(g).ToString("dd.MM HH:mm") : "—")</td>
                        <td class="small text-muted">@e.SonHata</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
