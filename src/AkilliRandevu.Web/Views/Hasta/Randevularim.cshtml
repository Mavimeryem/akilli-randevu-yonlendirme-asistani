@model List<RandevuSatiri>
@{
    ViewData["Title"] = "Randevularım";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Randevularım</h1>
    <a class="btn btn-primary" asp-controller="Randevu" asp-action="Al">Yeni randevu al</a>
</div>

@if (Model.Count == 0)
{
    <p class="text-muted">Henüz randevunuz yok.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Tarih</th>
                    <th>Bölüm</th>
                    <th>Doktor</th>
                    <th>Durum</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model)
                {
                    var r = s.Randevu;
                    <tr>
                        <td>@r.BaslangicZamani.ToString("dd.MM.yyyy HH:mm")</td>
                        <td>@r.Doktor.Bolum.Ad</td>
                        <td>@r.Doktor.Unvan @r.Doktor.Kullanici.Ad @r.Doktor.Kullanici.Soyad</td>
                        <td><partial name="_RandevuDurumu" model="r.Durum" /></td>
                        <td class="text-end"><partial name="_RandevuIslemleri" model="s" /></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <p class="form-text">Randevunuzu en geç başlangıçtan 2 saat öncesine kadar iptal edebilirsiniz.</p>
}
