@model List<AkilliRandevu.Entities.Concrete.Randevu>
@{
    ViewData["Title"] = "Randevularım";
}

<h1 class="h3 mb-3">Randevularım</h1>

@if (Model.Count == 0)
{
    <p class="text-muted">Henüz randevunuz yok.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Tarih</th>
                    <th>Bölüm</th>
                    <th>Doktor</th>
                    <th>Durum</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model)
                {
                    <tr>
                        <td>@r.BaslangicZamani.ToString("dd.MM.yyyy HH:mm")</td>
                        <td>@r.Doktor.Bolum.Ad</td>
                        <td>@r.Doktor.Unvan @r.Doktor.Kullanici.Ad @r.Doktor.Kullanici.Soyad</td>
                        <td><partial name="_RandevuDurumu" model="r.Durum" /></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
