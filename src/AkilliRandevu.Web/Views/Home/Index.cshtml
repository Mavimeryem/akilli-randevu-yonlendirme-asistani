@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Ortam
@{
    ViewData["Title"] = "Ana sayfa";
}

<div class="text-center py-4">
    <h1 class="display-6">Akıllı Randevu ve Poliklinik Yönlendirme Asistanı</h1>
    <p class="lead">Belirtilerinizi girin, doğru polikliniğe yönlendirilin, randevunuzu alın.</p>

    @if (User.Identity?.IsAuthenticated != true)
    {
        <a class="btn btn-primary" asp-controller="Hesap" asp-action="Giris">Giriş yap</a>
        <a class="btn btn-outline-primary" asp-controller="Hesap" asp-action="Kayit">Kayıt ol</a>
    }
    else
    {
        <p>Hoş geldiniz, <strong>@User.Identity.Name</strong>.</p>
    }
</div>

@if (Ortam.IsDevelopment())
{
    <div class="alert alert-info mx-auto" style="max-width: 36rem">
        <strong>Geliştirme ortamı – sentetik test hesapları</strong> (şifre: <code>@AkilliRandevu.Business.BusinessKayitlari.DemoSifre</code>)
        <ul class="mb-0">
            <li>Yönetici: <code>yonetici@ornek.test</code></li>
            <li>Doktor: <code>doktor1@ornek.test</code> … <code>doktor10@ornek.test</code></li>
            <li>Hasta: <code>hasta1@ornek.test</code> … <code>hasta8@ornek.test</code></li>
        </ul>
    </div>
}
